DB_PASSWORD=replace_with_a_long_random_password
DB_ROOT_PASSWORD=replace_with_another_long_random_password
SECRET_KEY=replace_with_a_long_random_secret_key
# Admin account: the only one that can create users.
# If ADMIN_EMAIL matches an existing user, that user becomes admin.
# ADMIN_PASSWORD (12+ chars) is only needed if the account doesn't exist yet.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
